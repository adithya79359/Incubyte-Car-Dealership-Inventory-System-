# Create these databases in PostgreSQL and replace the username/password below.
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/motorlane
TEST_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/motorlane_test
PORT=3001
# Optional locally; required in production. Use a random secret of at least 32 characters.
# JWT_SECRET=
